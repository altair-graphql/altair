{
  "name": "altair",
  "description": "Electron wrapper for Altair",
  "version": "8.5.11",
  "author": "Samuel Imolorhe <altair@sirmuel.design> (https://sirmuel.design/)",
  "bugs": "https://github.com/altair-graphql/altair/issues",
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/altair",
    "logo": "https://opencollective.com/altair/logo.txt"
  },
  "dependencies": {
    "@altairgraphql/electron-interop": "workspace:*",
    "@altairgraphql/electron-settings-static": "workspace:*",
    "@altairgraphql/login-redirect": "workspace:*",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@sentry/electron": "^7.20.1",
    "altair-static": "workspace:*",
    "body-parser": "^1.20.8",
    "csp-header": "^5.2.1",
    "electron-debug": "^3.2.0",
    "electron-is-dev": "^1.2.0",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^7.0.3",
    "electron-unhandled": "3.0.2",
    "electron-updater": "^6.8.10",
    "electron-util": "^0.12.3",
    "electron-window-state": "^5.0.3",
    "express": "^4.22.3",
    "get-port": "5.1.1",
    "mime-types": "^2.1.35",
    "rxjs": "7.8.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/notarize": "^2.5.0",
    "@playwright/test": "catalog:",
    "@sentry/cli": "^3.8.0",
    "@sentry/vite-plugin": "^4.9.1",
    "@sentry/wizard": "^6.13.0",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.25",
    "@types/mime-types": "^2.1.4",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "altair-graphql-core": "workspace:*",
    "devtron": "^1.4.0",
    "dotenv": "^8.6.0",
    "electron": "catalog:",
    "electron-builder": "26.17.0",
    "electron-builder-notarize": "^1.5.2",
    "electron-reloader": "^1.2.3",
    "electron-vite": "^5.0.0",
    "eslint": "^7.3.1",
    "eslint-config-altair": "workspace:*",
    "eslint-config-prettier": "8.5.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/altair"
  },
  "gitHead": "e5ce60f5a14997f1471a961ac76efacbb044df46",
  "license": "MIT",
  "main": "dist/main/index.js",
  "private": true,
  "productName": "Altair GraphQL Client",
  "repository": {
    "type": "git",
    "url": "https://github.com/altair-graphql/altair.git"
  },
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm compile && electron-builder --config electron-builder.config.ts",
    "compile": "pnpm typecheck && electron-vite build --outDir dist && pnpm sentry:sourcemaps:inject",
    "dev:old": "pnpm compile && electron ./dist/",
    "bootstrap": "pnpm compile",
    "postinstall": "electron-builder install-app-deps",
    "test": "pnpm test:unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "([[ -n $RUNNER_OS ]] && [[ $RUNNER_OS != 'Linux' ]]) && exit 0 || playwright test e2e",
    "test:unit": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "build:unpack": "npm run build && electron-builder --config electron-builder.config.ts --dir",
    "build:win": "npm run build && electron-builder --config electron-builder.config.ts --win",
    "build:mac": "npm run build && electron-builder --config electron-builder.config.ts --mac",
    "build:linux": "npm run build && electron-builder --config electron-builder.config.ts --linux",
    "sentry:sourcemaps:inject": "sentry-cli sourcemaps inject --org altair-graphql --project electron ./dist",
    "sentry:sourcemaps:upload": "sentry-cli sourcemaps upload --org altair-graphql --project electron ./dist",
    "sentry:sourcemaps": "pnpm sentry:sourcemaps:inject && pnpm sentry:sourcemaps:upload"
  }
}
